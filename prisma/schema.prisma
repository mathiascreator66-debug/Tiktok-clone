generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  /// Optional when phoneE164 is set (email OR phone registration).
  email         String?         @unique
  username      String          @unique
  passwordHash  String?
  displayName   String?
  avatarUrl     String?
  bio           String?
  googleId      String?         @unique
  /// Solde portefeuille en centimes (crédits virtuels démo)
  balanceCents  Int             @default(0)
  isPro         Boolean         @default(false)
  proUntil      DateTime?
  /// Essai Pro gratuit déjà utilisé (une fois)
  proTrialUsed  Boolean         @default(false)
  isAdmin       Boolean         @default(false)
  isModerator   Boolean         @default(false)
  isVerified    Boolean         @default(false)
  /// ACTIVE | SUSPENDED | BANNED
  accountStatus String          @default("ACTIVE")
  country       String?
  /// fr | en | zh
  language      String          @default("fr")
  birthdate     DateTime?
  /// Optional when email is set; E.164; SQLite UNIQUE allows multiple NULLs
  phoneE164     String?         @unique
  phoneCountry  String?
  createdAt     DateTime        @default(now())
  videos        Video[]
  likes         Like[]
  comments      Comment[]
  commentLikes  CommentLike[]
  reposts       Repost[]
  following     Follow[]        @relation("Following")
  followers     Follow[]        @relation("Followers")
  conversationsA Conversation[] @relation("ConvA")
  conversationsB Conversation[] @relation("ConvB")
  messages      Message[]
  stories       Story[]
  storyViews    StoryView[]
  storyComments StoryComment[]
  storyReactions StoryReaction[]
  bookmarks     Bookmark[]
  notInterested NotInterested[]
  reports       Report[]        @relation("Reporter")
  profileLinks  ProfileLink[]
  watchEvents   WatchEvent[]
  transactions  Transaction[]
  adminActions  AdminAction[]
  helpTickets   HelpTicket[]
  resolvedReports Report[]      @relation("ReportResolver")
}

model Video {
  id            String          @id @default(cuid())
  caption       String
  videoUrl      String
  soundName     String?
  /// Gallery-uploaded audio URL; when set, playback mutes original video audio
  soundUrl      String?
  durationSec   Float?
  pinnedAt      DateTime?
  /// Boost actif jusqu'à cette date (visibilité feed Pour toi)
  boostedUntil  DateTime?
  createdAt     DateTime        @default(now())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes         Like[]
  comments      Comment[]
  reposts       Repost[]
  bookmarks     Bookmark[]
  notInterested NotInterested[]
  reports       Report[]
  watchEvents   WatchEvent[]
  hashtags      VideoHashtag[]

  @@index([userId, pinnedAt])
}

model Hashtag {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  videos    VideoHashtag[]
}

model VideoHashtag {
  videoId   String
  hashtagId String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([videoId, hashtagId])
  @@index([hashtagId])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  videoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Comment {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  content   String
  imageUrl  String?
  userId    String
  videoId   String
  parentId  String?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]

  @@index([videoId, createdAt])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  commentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model Repost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  videoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Follow {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  followerId  String
  followingId String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

/// Pairwise DM thread. participantAId is always the lexicographically smaller user id.
model Conversation {
  id             String    @id @default(cuid())
  participantAId String
  participantBId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  participantA   User      @relation("ConvA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB   User      @relation("ConvB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([participantAId, participantBId])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Story {
  id          String          @id @default(cuid())
  userId      String
  mediaUrl    String
  caption     String?
  soundName   String?
  /// Gallery-uploaded audio; when set, mute original video audio on playback
  soundUrl    String?
  durationSec Float?
  createdAt   DateTime        @default(now())
  expiresAt   DateTime
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  views       StoryView[]
  comments    StoryComment[]
  reactions   StoryReaction[]

  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model StoryView {
  id        String   @id @default(cuid())
  userId    String
  storyId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([storyId])
}

model StoryComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  content   String
  userId    String
  storyId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@index([userId])
}

model StoryReaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  emoji     String
  userId    String
  storyId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId, emoji])
  @@index([storyId])
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  videoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
}

model NotInterested {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  videoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

/// Signalement : targetType = video|user|comment|story ; status = open|resolved|dismissed
model Report {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  userId       String
  targetType   String    @default("video")
  targetId     String
  videoId      String?
  reason       String
  status       String    @default("open")
  notes        String?
  resolvedAt   DateTime?
  resolvedById String?
  user         User      @relation("Reporter", fields: [userId], references: [id], onDelete: Cascade)
  video        Video?    @relation(fields: [videoId], references: [id], onDelete: SetNull)
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([videoId])
}

model ProfileLink {
  id        String @id @default(cuid())
  userId    String
  url       String
  label     String?
  sortOrder Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WatchEvent {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
  @@index([videoId])
}

/// Historique portefeuille (crédits virtuels — démo, pas d'argent réel)
model Transaction {
  id          String   @id @default(cuid())
  userId      String
  /// credit | debit | tip_sent | tip_received | boost | subscription
  type        String
  amountCents Int
  /// JSON optionnel : { note, feeCents, counterpartyId, videoId, demo: true, ... }
  meta        String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AdminAction {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String
  action     String
  targetType String?
  targetId   String?
  meta       String?
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId])
}

model HelpTicket {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  email     String
  subject   String
  message   String
  status    String   @default("open")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}
