generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  /// Optional when phoneE164 is set (email OR phone registration).
  email         String?         @unique
  username      String          @unique
  passwordHash  String?
  displayName   String?
  avatarUrl     String?
  bio           String?
  googleId      String?         @unique
  /// Solde portefeuille en centimes (crédits virtuels démo)
  balanceCents  Int             @default(0)
  isPro         Boolean         @default(false)
  proUntil      DateTime?
  /// Essai Pro gratuit déjà utilisé (une fois)
  proTrialUsed  Boolean         @default(false)
  isAdmin       Boolean         @default(false)
  isModerator   Boolean         @default(false)
  isVerified    Boolean         @default(false)
  /// ACTIVE | SUSPENDED | BANNED
  accountStatus String          @default("ACTIVE")
  country       String?
  /// fr | en | zh
  language      String          @default("fr")
  /// light | dark
  theme         String          @default("light")
  birthdate     DateTime?
  /// Optional when email is set; E.164; SQLite UNIQUE allows multiple NULLs
  phoneE164     String?         @unique
  phoneCountry  String?
  createdAt     DateTime        @default(now())
  videos        Video[]
  likes         Like[]
  comments      Comment[]
  commentLikes  CommentLike[]
  reposts       Repost[]
  following     Follow[]        @relation("Following")
  followers     Follow[]        @relation("Followers")
  conversationsA Conversation[] @relation("ConvA")
  conversationsB Conversation[] @relation("ConvB")
  messages      Message[]
  stories       Story[]
  storyViews    StoryView[]
  storyComments StoryComment[]
  storyReactions StoryReaction[]
  bookmarks     Bookmark[]
  notInterested NotInterested[]
  reports       Report[]        @relation("Reporter")
  profileLinks  ProfileLink[]
  watchEvents   WatchEvent[]
  transactions  Transaction[]
  adminActions  AdminAction[]
  helpTickets   HelpTicket[]
  resolvedReports Report[]      @relation("ReportResolver")
  playlists     Playlist[]
  communitiesOwned Community[]  @relation("CommunityOwner")
  communityMemberships CommunityMember[]
  communityPosts CommunityPost[]
  communityPostLikes CommunityPostLike[]
  communityPostComments CommunityPostComment[]
  lives         Live[]
  liveComments  LiveComment[]
  liveLikes     LiveLike[]
  posts         Post[]
  postLikes     PostLike[]
  postComments  PostComment[]
  blocksInitiated Block[] @relation("Blocker")
  blocksReceived  Block[] @relation("Blocked")
}

model Video {
  id            String          @id @default(cuid())
  caption       String
  videoUrl      String
  /// Custom cover / thumbnail JPEG (frame ± text baked in)
  coverUrl      String?
  soundName     String?
  /// Gallery-uploaded audio URL; mixes with original (do not force-mute original)
  soundUrl      String?
  /// Gain for original video audio track (0–2). Default 1 = 100%
  originalVolume Float          @default(1)
  /// Gain for gallery audio (0–2). Default 1 = 100%
  soundVolume   Float           @default(1)
  /// Trim start of gallery audio in ms
  soundTrimStartMs Int          @default(0)
  /// Trim end of gallery audio in ms; null = full file
  soundTrimEndMs Int?
  /// Playback trim: start of video clip in ms
  videoTrimStartMs Int          @default(0)
  /// Playback trim: end of video clip in ms; null = full file
  videoTrimEndMs Int?
  /// JSON array of text overlays: {id,text,fontFamily,fontSize,color,bgColor?,align,xPct,yPct,startMs,endMs?,bold,italic,stroke?}
  textOverlays  String?
  /// JSON array of caption cues: {startMs,endMs,text}
  captions      String?
  durationSec   Float?
  pinnedAt      DateTime?
  /// Boost actif jusqu'à cette date (visibilité feed Pour toi)
  boostedUntil  DateTime?
  /// Author allows viewers to download the video file
  allowDownload Boolean         @default(true)
  createdAt     DateTime        @default(now())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes         Like[]
  comments      Comment[]
  reposts       Repost[]
  bookmarks     Bookmark[]
  notInterested NotInterested[]
  reports       Report[]
  watchEvents   WatchEvent[]
  hashtags      VideoHashtag[]
  playlistItems PlaylistItem[]

  @@index([userId, pinnedAt])
}

model Hashtag {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  videos    VideoHashtag[]
}

model VideoHashtag {
  videoId   String
  hashtagId String
  video     Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([videoId, hashtagId])
  @@index([hashtagId])
}

model Like {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  videoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Comment {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  content   String
  imageUrl  String?
  userId    String
  videoId   String
  parentId  String?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  likes     CommentLike[]

  @@index([videoId, createdAt])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  commentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model Repost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  videoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Follow {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  followerId  String
  followingId String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

/// Pairwise DM thread. participantAId is always the lexicographically smaller user id.
model Conversation {
  id             String    @id @default(cuid())
  participantAId String
  participantBId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  participantA   User      @relation("ConvA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB   User      @relation("ConvB", fields: [participantBId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([participantAId, participantBId])
  @@index([updatedAt])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  senderId        String
  /// Encrypted text; may be empty when media-only
  body            String       @default("")
  imageUrl        String?
  videoUrl        String?
  audioUrl        String?
  audioDurationMs Int?
  createdAt       DateTime     @default(now())
  readAt          DateTime?
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Story {
  id          String          @id @default(cuid())
  userId      String
  mediaUrl    String
  caption     String?
  soundName   String?
  /// Gallery-uploaded audio; mixes with original (do not force-mute original)
  soundUrl    String?
  /// Gain for original media audio (0–2)
  originalVolume Float        @default(1)
  soundVolume Float           @default(1)
  soundTrimStartMs Int        @default(0)
  soundTrimEndMs Int?
  durationSec Float?
  createdAt   DateTime        @default(now())
  expiresAt   DateTime
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  views       StoryView[]
  comments    StoryComment[]
  reactions   StoryReaction[]

  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model StoryView {
  id        String   @id @default(cuid())
  userId    String
  storyId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([storyId])
}

model StoryComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  content   String
  userId    String
  storyId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, createdAt])
  @@index([userId])
}

model StoryReaction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  emoji     String
  userId    String
  storyId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId, emoji])
  @@index([storyId])
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  videoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
}

model NotInterested {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  videoId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

/// Signalement : targetType = video|user|comment|story ; status = open|resolved|dismissed
model Report {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  userId       String
  targetType   String    @default("video")
  targetId     String
  videoId      String?
  reason       String
  status       String    @default("open")
  notes        String?
  resolvedAt   DateTime?
  resolvedById String?
  user         User      @relation("Reporter", fields: [userId], references: [id], onDelete: Cascade)
  video        Video?    @relation(fields: [videoId], references: [id], onDelete: SetNull)
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([videoId])
}

model ProfileLink {
  id        String @id @default(cuid())
  userId    String
  url       String
  label     String?
  sortOrder Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WatchEvent {
  id          String   @id @default(cuid())
  /// Null = spectateur anonyme
  userId      String?
  videoId     String
  watchedAt   DateTime @default(now())
  /// Durée regardée en ms (meilleure estimation)
  watchMs     Int?
  /// True si la vidéo a été vue jusqu’à la fin (ou ≥ 95 %)
  completed   Boolean  @default(false)
  /// pour_toi | profil | recherche | abonnements | autre
  source      String?
  /// Progression 0–100 si connue
  progressPct Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
  @@index([videoId, watchedAt])
}

/// Historique portefeuille (crédits virtuels — démo, pas d'argent réel)
model Transaction {
  id          String   @id @default(cuid())
  userId      String
  /// credit | debit | tip_sent | tip_received | boost | subscription
  type        String
  amountCents Int
  /// JSON optionnel : { note, feeCents, counterpartyId, videoId, demo: true, ... }
  meta        String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AdminAction {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String
  action     String
  targetType String?
  targetId   String?
  meta       String?
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorId])
}

model HelpTicket {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  email     String
  subject   String
  message   String
  status    String   @default("open")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}


model Playlist {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String?
  coverUrl    String?
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       PlaylistItem[]

  @@index([userId, createdAt])
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId, sortOrder])
  @@index([videoId])
}

model Community {
  id          String            @id @default(cuid())
  ownerId     String
  name        String
  slug        String            @unique
  description String?
  rules       String?
  avatarUrl   String?
  coverUrl    String?
  isPublic    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  owner       User              @relation("CommunityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     CommunityMember[]
  posts       CommunityPost[]

  @@index([ownerId])
  @@index([createdAt])
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  /// OWNER | ADMIN | MEMBER
  role        String    @default("MEMBER")
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityPost {
  id          String                 @id @default(cuid())
  communityId String
  authorId    String
  content     String
  imageUrl    String?
  videoUrl    String?
  viewCount   Int                    @default(0)
  pinnedAt    DateTime?
  createdAt   DateTime               @default(now())
  community   Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author      User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes       CommunityPostLike[]
  comments    CommunityPostComment[]

  @@index([communityId, createdAt])
  @@index([communityId, pinnedAt])
}

model CommunityPostLike {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model CommunityPostComment {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}


model Live {
  id           String        @id @default(cuid())
  userId       String
  title        String?
  /// LIVE | ENDED
  status       String        @default("LIVE")
  viewerPeak   Int           @default(0)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments     LiveComment[]
  likes        LiveLike[]

  @@index([status, startedAt])
  @@index([userId, status])
}

model LiveComment {
  id        String   @id @default(cuid())
  liveId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  live      Live     @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([liveId, createdAt])
}

model LiveLike {
  id        String   @id @default(cuid())
  liveId    String
  userId    String
  createdAt DateTime @default(now())
  live      Live     @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveId, userId])
}

model Post {
  id         String        @id @default(cuid())
  authorId   String
  content    String
  /// PUBLIC | FOLLOWERS
  visibility String        @default("PUBLIC")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images     PostImage[]
  likes      PostLike[]
  comments   PostComment[]

  @@index([authorId, createdAt])
  @@index([createdAt])
}

model PostImage {
  id        String @id @default(cuid())
  postId    String
  imageUrl  String
  sortOrder Int    @default(0)
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  /// like | love | haha | wow | sad | angry
  reaction  String   @default("like")
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}


model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
