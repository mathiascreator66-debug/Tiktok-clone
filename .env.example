# URL de la base SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:./dev.db"

# Secret pour signer les cookies de session JWT (min. 32 caractères)
AUTH_SECRET="remplacez-par-un-secret-aleatoire-long"

# URL publique de l'app (sans slash final) — utilisez HTTPS en production
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optionnel) — Google Cloud Console > APIs & Services > Identifiants
# Type : application Web
# URI de redirection autorisée (EXACTE, sans slash final sur APP_URL) :
#   https://votre-domaine.example/api/auth/google/callback
# Exemple tunnel actuel :
#   https://september-henderson-tampa-abroad.trycloudflare.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email OTP (optionnel / secondaire) — laisser vide = codes loggés en console uniquement
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="AfriVoix <noreply@afrivoix.local>"

# Chiffrement optionnel des messages privés au repos (AES-256-GCM).
# Si défini (min. 16 caractères), les nouveaux messages sont chiffrés.
# Les messages plaintext existants restent lisibles. Phase 2 : migration complète.
# MESSAGES_ENCRYPTION_KEY="remplacez-par-une-cle-longue-aleatoire"

# Stripe (futur — non requis pour la démo monétisation)
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

