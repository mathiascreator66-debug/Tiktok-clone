# URL de la base SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:./dev.db"

# Secret pour signer les cookies de session JWT (min. 32 caractères)
AUTH_SECRET="remplacez-par-un-secret-aleatoire-long"

# URL publique de l'app (sans slash final) — requis pour Google OAuth
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optionnel) — Google Cloud Console > APIs & Services > Identifiants
# Type : application Web
# URI de redirection autorisée : http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
